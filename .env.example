# FamilyGPU Orchestrator — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# Database path (default: ~/.familygpu/familygpu.db)
# DATABASE_URL=~/.familygpu/familygpu.db

# Optional: override master key location (default: ~/.familygpu/.master_key)
# MASTER_KEY_PATH=~/.familygpu/.master_key

# Optional: enable debug logging
# LOG_LEVEL=DEBUG

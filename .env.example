# FamilyGPU Orchestrator — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# Database path (default: ./familygpu.db)
# DATABASE_URL=./familygpu.db

# Optional: override master key location (default: ./.master_key)
# MASTER_KEY_PATH=./.master_key

# Optional: enable debug logging
# LOG_LEVEL=DEBUG
